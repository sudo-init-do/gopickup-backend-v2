# App
APP_ENV=development
APP_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gopickup

# Plunk (Mailing)
PLUNK_API_KEY=your_plunk_api_key_here
PLUNK_FROM_EMAIL=hello@gopickup.com
PLUNK_FROM_NAME=GoPickup

# Cloudflare R2 (durable image uploads).
# When all five are set, uploads go to R2 instead of the ephemeral local disk.
# Endpoint is derived as https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gopickup-uploads
R2_PUBLIC_BASE_URL=https://cdn.gopickup.com.ng
